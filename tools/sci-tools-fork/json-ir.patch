diff --git a/SCI/Decompile/JsonExport.cs b/SCI/Decompile/JsonExport.cs
new file mode 100644
index 0000000..123922d
--- /dev/null
+++ b/SCI/Decompile/JsonExport.cs
@@ -0,0 +1,214 @@
+using System.Collections.Generic;
+using System.IO;
+using System.Text;
+using SCI.Resource;
+using RObject = SCI.Resource.Object;   // disambiguate from System.Object
+
+// Structured JSON IR of a game: the selector table plus, per script, its objects
+// (properties + methods) and procedures, with EACH function body serialized as its
+// typed control-flow AST (SCI.Decompile.Ast). The decompiler builds that AST and then
+// discards it after emitting .sc text; this exposes it losslessly for downstream
+// analysis (the softlock extractor consumes this instead of re-parsing .sc text).
+//
+// Identifiers are BYTECODE-canonical: globals/locals by index, selectors by number
+// (with the vocab.997 name table emitted so a consumer can resolve names). Friendly
+// global names (gCurrentStatus) are an annotation layer and are NOT applied here.
+//
+// Hand-written JSON so SCI.csproj stays dependency-free (netstandard2.0, no NuGet).
+
+namespace SCI.Decompile
+{
+    static class JsonExport
+    {
+        public static void Run(Game game, List<ScriptSummary> scripts, string path)
+        {
+            var sb = new StringBuilder(1 << 20);
+            sb.Append('{');
+            Key(sb, "game"); Str(sb, game.Name); sb.Append(',');
+
+            Key(sb, "selectors"); sb.Append('[');
+            var sel = game.Selectors ?? new string[0];
+            for (int i = 0; i < sel.Length; i++) { if (i > 0) sb.Append(','); Str(sb, sel[i]); }
+            sb.Append("],");
+
+            Key(sb, "scripts"); sb.Append('[');
+            for (int i = 0; i < scripts.Count; i++) { if (i > 0) sb.Append(','); EmitScript(sb, scripts[i]); }
+            sb.Append(']');
+
+            sb.Append('}');
+            File.WriteAllText(path, sb.ToString());
+        }
+
+        static void EmitScript(StringBuilder sb, ScriptSummary ss)
+        {
+            var script = ss.Script;
+            sb.Append('{');
+            Key(sb, "number"); sb.Append(script.Number); sb.Append(',');
+
+            Key(sb, "locals"); sb.Append('[');   // script 0's locals ARE the globals
+            for (int i = 0; i < script.Locals.Count; i++)
+            {
+                if (i > 0) sb.Append(',');
+                var l = script.Locals[i];
+                sb.Append('{'); Key(sb, "index"); sb.Append(i);
+                sb.Append(','); Key(sb, "value"); sb.Append(l.Value); sb.Append('}');
+            }
+            sb.Append("],");
+
+            Key(sb, "objects"); sb.Append('[');
+            for (int i = 0; i < script.Objects.Count; i++)
+            {
+                if (i > 0) sb.Append(',');
+                EmitObject(sb, ss, script.Objects[i]);
+            }
+            sb.Append("],");
+
+            Key(sb, "procedures"); sb.Append('[');
+            bool first = true;
+            foreach (var proc in script.Procedures)
+            {
+                if (!first) sb.Append(','); first = false;
+                sb.Append('{');
+                Key(sb, "name"); Str(sb, proc.Name); sb.Append(',');
+                Key(sb, "ast"); EmitAst(sb, ss, proc);
+                sb.Append('}');
+            }
+            sb.Append(']');
+
+            sb.Append('}');
+        }
+
+        static void EmitObject(StringBuilder sb, ScriptSummary ss, RObject obj)
+        {
+            sb.Append('{');
+            Key(sb, "name"); Str(sb, obj.Name); sb.Append(',');
+            Key(sb, "isClass"); sb.Append(obj.IsClass ? "true" : "false"); sb.Append(',');
+            Key(sb, "species"); sb.Append(obj.Species); sb.Append(',');
+            Key(sb, "super"); sb.Append(obj.SuperClass); sb.Append(',');
+
+            Key(sb, "properties"); sb.Append('[');
+            for (int i = 0; i < obj.Properties.Count; i++)
+            {
+                if (i > 0) sb.Append(',');
+                var p = obj.Properties[i];
+                sb.Append('{');
+                Key(sb, "sel"); sb.Append(p.Selector); sb.Append(',');
+                Key(sb, "name"); Str(sb, p.Name); sb.Append(',');
+                Key(sb, "value"); sb.Append(p.Value);
+                sb.Append('}');
+            }
+            sb.Append("],");
+
+            Key(sb, "methods"); sb.Append('[');
+            for (int i = 0; i < obj.Methods.Count; i++)
+            {
+                if (i > 0) sb.Append(',');
+                var m = obj.Methods[i];
+                sb.Append('{');
+                Key(sb, "sel"); sb.Append(m.Selector); sb.Append(',');
+                Key(sb, "name"); Str(sb, m.Name); sb.Append(',');
+                Key(sb, "ast"); EmitAst(sb, ss, m);
+                sb.Append('}');
+            }
+            sb.Append(']');
+
+            sb.Append('}');
+        }
+
+        static void EmitAst(StringBuilder sb, ScriptSummary ss, Function fn)
+        {
+            FunctionSummary fsum;
+            if (fn == null || !ss.Functions.TryGetValue(fn, out fsum) || fsum.Ast == null)
+            {
+                sb.Append("null");
+                return;
+            }
+            EmitNode(sb, fsum.Ast);
+        }
+
+        static void EmitNode(StringBuilder sb, Ast.Node n)
+        {
+            sb.Append('{');
+            Key(sb, "t"); Str(sb, n.Type.ToString());
+
+            if (n is Ast.Number num) { sb.Append(','); Key(sb, "value"); sb.Append(num.Value); }
+            else if (n is Ast.String str) { sb.Append(','); Key(sb, "value"); Str(sb, str.Value); }
+            else if (n is Ast.Said said) { sb.Append(','); Key(sb, "value"); Str(sb, said.Value); }
+            else if (n is Ast.Selector selN)
+            {
+                sb.Append(','); Key(sb, "name"); Str(sb, selN.Name);
+                sb.Append(','); Key(sb, "value"); sb.Append(selN.Value);
+            }
+            else if (n is Ast.Class cls)
+            {
+                sb.Append(','); Key(sb, "name"); Str(sb, cls.Name);
+                sb.Append(','); Key(sb, "number"); sb.Append(cls.Number);
+            }
+            else if (n is Ast.Obj o) { sb.Append(','); Key(sb, "name"); Str(sb, o.Name); }
+            else if (n is Ast.Variable v)
+            {
+                sb.Append(','); Key(sb, "vtype"); Str(sb, v.VariableType.ToString());
+                sb.Append(','); Key(sb, "index"); sb.Append(v.Index);
+            }
+            else if (n is Ast.Property prop)
+            {
+                sb.Append(','); Key(sb, "name"); Str(sb, prop.Name);
+                sb.Append(','); Key(sb, "index"); sb.Append(prop.Index);
+            }
+            else if (n is Ast.KernelCall kc)
+            {
+                sb.Append(','); Key(sb, "name"); Str(sb, kc.Name);
+                sb.Append(','); Key(sb, "func"); sb.Append(kc.Function);
+            }
+            else if (n is Ast.PublicCall pc)
+            {
+                sb.Append(','); Key(sb, "name"); Str(sb, pc.Name);
+                sb.Append(','); Key(sb, "script"); sb.Append(pc.Script);
+                sb.Append(','); Key(sb, "export"); sb.Append(pc.Export);
+            }
+            else if (n is Ast.LocalCall lc)
+            {
+                sb.Append(','); Key(sb, "name"); Str(sb, lc.Name);
+                sb.Append(','); Key(sb, "offset"); sb.Append(lc.Offset);
+            }
+
+            if (n.Children.Count > 0)
+            {
+                sb.Append(','); Key(sb, "kids"); sb.Append('[');
+                for (int i = 0; i < n.Children.Count; i++)
+                {
+                    if (i > 0) sb.Append(',');
+                    EmitNode(sb, n.Children[i]);
+                }
+                sb.Append(']');
+            }
+            sb.Append('}');
+        }
+
+        static void Key(StringBuilder sb, string k) { sb.Append('"').Append(k).Append("\":"); }
+
+        static void Str(StringBuilder sb, string s)
+        {
+            sb.Append('"');
+            if (s != null)
+            {
+                foreach (char c in s)
+                {
+                    switch (c)
+                    {
+                        case '"': sb.Append("\\\""); break;
+                        case '\\': sb.Append("\\\\"); break;
+                        case '\n': sb.Append("\\n"); break;
+                        case '\r': sb.Append("\\r"); break;
+                        case '\t': sb.Append("\\t"); break;
+                        default:
+                            if (c < 0x20) sb.Append("\\u").Append(((int)c).ToString("x4"));
+                            else sb.Append(c);
+                            break;
+                    }
+                }
+            }
+            sb.Append('"');
+        }
+    }
+}

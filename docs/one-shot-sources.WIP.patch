+    def _src_fires(self, ban, R, state):
+        """Can one of `ban`'s acquisitions actually FIRE in this state? See `source_reqs`.
+
+        Only the register(s) THIS projection tracks are judged; anything else is left free, which
+        is the permissive direction every projection already takes. A source site we recorded no
+        requirement for satisfies this trivially, so nothing that was re-obtainable before stops
+        being so unless the game latched it."""
+        room, val = state
+        vals = dict(zip(R, val)) if isinstance(R, tuple) else {R: val}
+        sites = [req for it in ban for req in self._src_req.get((it, room), ())]
+        if not sites:
+            return True                       # `sources` says this room is one; we know no better
+        return any(all(vals[Ri] in need for Ri, need in req.items() if Ri in vals)
+                   for req in sites)
+
